+    m_isActive = false;
+    m_netButton->setButtonIcon(QIcon::fromTheme("ukui-vpn-symbolic"));
+    setIcon(false);
+    const QString str=tr("Not connected");
+    m_nameLabel->setText(str);
+    this->m_infoButton->hide();
