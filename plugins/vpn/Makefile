uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/ukui-control-center/$(TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/ukui-control-center/ 


install_trans: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/kylin-nm/vpn/ || mkdir -p $(INSTALL_ROOT)/usr/share/kylin-nm/vpn/
	-$(QINSTALL) /home/cxc/project/vpn/kylin-nm/plugins/vpn/translations/zh_CN.qm $(INSTALL_ROOT)/usr/share/kylin-nm/vpn/zh_CN.qm
	-$(QINSTALL) /home/cxc/project/vpn/kylin-nm/plugins/vpn/translations/zh_CN.ts $(INSTALL_ROOT)/usr/share/kylin-nm/vpn/zh_CN.ts

uninstall_trans: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/kylin-nm/vpn/zh_CN.ts
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/kylin-nm/vpn/zh_CN.qm
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/kylin-nm/vpn/ 


install: install_target install_trans  FORCE

uninstall: uninstall_target uninstall_trans  FORCE

FORCE:

