	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)
	-$(DEL_FILE) ../../libnm-base-kylin/$(TARGET)
	-$(MOVE) $(TARGET) ../../libnm-base-kylin/$(TARGET)
	-$(DEL_FILE) ../../libnm-base-kylin/$(TARGET0)
	-$(DEL_FILE) ../../libnm-base-kylin/$(TARGET1)
	-$(DEL_FILE) ../../libnm-base-kylin/$(TARGET2)
