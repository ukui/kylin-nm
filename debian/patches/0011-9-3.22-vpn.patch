+void VpnListItem::updateConnectionState(ConnectState state)
+{
+    m_vpnConnectItem.m_connectState = (NetworkManager::ActiveConnection::State)state;
+
+    if (Deactivated == state || Activated == state) {
+        m_netButton->stopLoading();
