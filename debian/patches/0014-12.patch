+                       "/org/ukui/SettingsDaemon/AppProxy",
+                       "org.ukui.SettingsDaemon.AppProxy",
+                       QDBusConnection::sessionBus());
+
+    if(!dbusInterface.isValid()) {
+        qWarning ()<< "init AppProxy dbus error";
+        return appList;
